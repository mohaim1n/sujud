<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Sujud</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    
    <!-- Privacy Descriptions written for App Store review compliance -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Sujud requires your location to compute exact astronomical prayer times and determine the precise Qibla direction to Makkah from where you are.</string>
    
    <key>NSMicrophoneUsageDescription</key>
    <string>Sujud processes audio in real time strictly in-memory during prayer sessions to recognize Arabic prayer recitation. Audio recordings and transcripts are never saved, logged, or uploaded.</string>
    
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Sujud uses on-device Arabic speech recognition to verify prayer recitation phrases during your prayer sessions.</string>
    
    <key>NSMotionUsageDescription</key>
    <string>Sujud uses motion sensors to detect prayer posture sequences (standing, bowing, prostration, sitting) to confirm completed rakahs.</string>

    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
    
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
