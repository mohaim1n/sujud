<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Sujud Watch</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>WKApplication</key>
    <true/>
    <key>WKCompanionAppBundleIdentifier</key>
    <string>com.sujud.app</string>
    
    <!-- Privacy Descriptions -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Sujud uses your location on Apple Watch to calculate local prayer times independently when disconnected from your iPhone.</string>
    
    <key>NSMicrophoneUsageDescription</key>
    <string>Sujud processes audio in memory only while an active prayer session is running on your Apple Watch to verify prayer recitation. Audio is never saved or uploaded.</string>
    
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Sujud uses on-device speech recognition to verify Arabic recitation during active prayer sessions.</string>
    
    <key>NSMotionUsageDescription</key>
    <string>Sujud uses the Apple Watch accelerometer and gyroscope during prayer sessions to detect Ruku and Sujud postures.</string>

    <!-- Extended Runtime Session for Wrist-Down App Execution -->
    <key>WKBackgroundModes</key>
    <array>
        <string>mindfulness</string>
        <string>physical-therapy</string>
    </array>
</dict>
</plist>
